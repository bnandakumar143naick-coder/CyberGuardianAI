# Copy this file to .env and fill in real values.
# Never commit your real .env file to GitHub.

# Flask
SECRET_KEY=change-this-to-a-random-secret
FLASK_DEBUG=True

# Set to True only if you intentionally want to retain uploaded images on disk
KEEP_UPLOADS=False

# Generative AI (optional) - if left blank, CyberGuardian uses its
# built-in rule-based explanation engine instead.
AI_API_KEY=your_api_key_here
AI_MODEL=claude-sonnet-4-6
